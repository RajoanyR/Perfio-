  id_utilisateur BigInt
  description    String?
  temps_passe    Decimal     @db.Decimal(8, 2)
  date_activite  DateTime    @default(now()) @db.Timestamptz(6)
  tache          tache       @relation(fields: [id_tache], references: [id_tache], onDelete: Cascade, onUpdate: NoAction, map: "fk_activite_1")
  utilisateur    utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onUpdate: NoAction, map: "fk_activite_2")

  @@index([id_tache, date_activite], map: "idx_activite_tache_date")
  @@index([id_utilisateur, date_activite], map: "idx_activite_user_date")
  @@schema("construct")
}

