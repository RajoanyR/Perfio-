# PostgreSQL existant — ne pas utiliser prisma migrate reset
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/opqual?schema=construct"
DATABASE_URL_DOCKER="postgresql://postgres:PASSWORD@host.docker.internal:5432/opqual?schema=construct"

# Secret JWT long et aléatoire, différent selon l'environnement
JWT_SECRET=change-me-with-a-long-random-secret

# Port HTTP de NestJS
PORT=3000

# Origines React autorisées, séparées par des virgules si plusieurs
FRONTEND_URL=http://localhost:5173

# Inactivité maximale côté serveur (minutes) avant fermeture de la session. Défaut : 10.
# Le frontend avertit à 6 min et déconnecte à 7 min ; garder une marge au-dessus de 7.
SESSION_INACTIVITY_MINUTES=10
